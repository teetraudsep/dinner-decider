# Copy this file to `.env` and fill in the values from
# Supabase Dashboard → Project Settings → API Keys (and Data API for the URL).
# `.env` is ignored by Git; this example file is committed.
# NEVER put the Anthropic API key in any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
